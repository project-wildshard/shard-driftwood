{
  "compilerOptions": {
    "target": "ES2024",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client",
      "@wildshard/engine/game/types"
    ],
    "allowArbitraryExtensions": true,
    "exactOptionalPropertyTypes": true
  },
  "files": [
    "driftwood-isle/native.ts",
    "driftwood-isle/tape.ts",
    "driftwood-isle/witness.ts",
    "driftwood-isle/worker.ts"
  ],
  "include": [],
  "compileOnSave": false
}
